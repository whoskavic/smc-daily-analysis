# ─────────────────────────────────────────────────────────────────────────────
# SMC Auto-Trading Terminal — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# ── TRADING MODE ──────────────────────────────────────────────────────────────
# "paper" = virtual wallet, no real money (START HERE)
# "live"  = real orders (only after validating paper results for 2+ weeks)
TRADE_MODE=paper

# Which exchange to use for execution
# Options: binance | bybit | okx | mexc
ACTIVE_EXCHANGE=binance

# ── BINANCE (existing) ────────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── BYBIT ────────────────────────────────────────────────────────────────────
# Recommended primary: min order $1, clean API
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── OKX ──────────────────────────────────────────────────────────────────────
# Requires passphrase in addition to key+secret
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# ── MEXC ─────────────────────────────────────────────────────────────────────
# Good for altcoins not listed on other exchanges
MEXC_API_KEY=
MEXC_API_SECRET=

# ── RISK MANAGEMENT ───────────────────────────────────────────────────────────
RISK_PER_TRADE_PCT=1.0            # Risk 1% of balance per trade
MAX_CONCURRENT_POSITIONS=3        # Max open positions at once
MAX_DAILY_DRAWDOWN_PCT=5.0        # Auto-pause if daily loss exceeds this %
MAX_LEVERAGE=10                   # Hard cap on leverage
PAPER_STARTING_BALANCE=1000.0    # Starting virtual USDT for paper trading

# ── SWARM ────────────────────────────────────────────────────────────────────
SWARM_ENABLED=true
SWARM_CONCURRENCY=8               # Parallel token analysis (respect rate limits)
SWARM_TOP_N=50                    # Scan top N market cap tokens
SWARM_MIN_CONFIDENCE=85           # Min Claude confidence % to trigger execution
SWARM_INTERVAL_MINUTES=15         # Scan interval during active sessions

# ── SYMBOLS (leave empty to use dynamic Top 50 market cap) ───────────────────
# Set specific symbols to override dynamic list:
# WATCH_SYMBOLS=["BTC/USDT","ETH/USDT","SOL/USDT"]
WATCH_SYMBOLS=

# ── SCHEDULER ────────────────────────────────────────────────────────────────
DAILY_ANALYSIS_TIME=08:00
TIMEZONE=Asia/Jakarta

# ── DATABASE ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./smc_trading.db
# For production: postgresql://user:password@localhost/smc_trading

# ── COINGECKO (optional) ──────────────────────────────────────────────────────
# Free tier (no key): 30 req/min — sufficient for daily refresh
# Pro key: 500 req/min — needed if running many instances
COINGECKO_API_KEY=

# ── TRADINGVIEW WEBHOOK (optional) ────────────────────────────────────────────
# Set a secret token to validate TV webhook requests
# In TradingView: Alerts → Webhook URL → https://your-server/webhook/tradingview
TV_WEBHOOK_SECRET=
